# Validated Apple M5 Pro / Mac17,9 single-stream Qwen W4A8 G128 profile.
# Correctness defaults remain in FlagGems; this file contains deployment and
# measured performance policy only.
export VLLM_PLUGINS=fl
export FL_CPU_INT4=1
export FL_CPU_INT4_BACKEND=libtriton_jit
export FLAGGEMS_VENDOR=arm
export FLAGGEMS_ARM_Q4_STRICT=1

export FLAGGEMS_Q4_DECODE_PARTITIONS=auto
# Smaller claims reduce heterogeneous-core tail latency without the atomic
# overhead seen at 16.  Two whole-model A/Bs found chunk 24 0.38%-0.74%
# faster than 32 with exact output tokens.
export FLAGGEMS_Q4_STEAL_CHUNK=24
export FLAGGEMS_ARM_Q4_G128_STEALING_DECODE=1
# Include the K6144/N5120 attention output projection in dynamic N4 work
# stealing while leaving the tiny K5120/N96 GDN projection static.  Two
# independent same-engine A/Bs improved tg96 by 0.54% and tg128 by 0.75%.
export FLAGGEMS_ARM_Q4_G128_STEALING_MIN_WORK=16777216
export FLAGGEMS_ARM_Q4_G128_SWIGLU_STEALING=1
export FLAGGEMS_ARM_Q4_G128_GATEUP_SWIGLU=1
export FLAGGEMS_ARM_Q4_G128_GATEUP_SWIGLU_STEAL_CHUNK=28
# Keep gate/up+SwiGLU and down inside one dispatcher call. Two independent
# whole-model A/Bs were positive (+0.71% tg128, +0.57% tg192) with exact
# tokens; paired medians support the more conservative +0.3%-0.7% range.
export FLAGGEMS_ARM_Q4_G128_FUSED_MLP=1
# Six QoS-prioritized Super-core workers plus nine additional workers give the
# persistent MLP the best post-QoS balance on this 18-core host. Cold tg128
# TPOT: 69.23 ms -> 68.83 ms (14.45 -> 14.53 tok/s), exact output tokens.
export FLAGGEMS_ARM_Q4_G128_MLP_THREADS=15
# GateUp and Down have different output widths and therefore different ideal
# work-stealing claim sizes. An 11-round same-engine A/B won 10/11 pairs
# (+1.41% median); cold tg128 TPOT improved 68.832 -> 68.550 ms with exact
# output tokens when GateUp used 28 and Down used 16.
export FLAGGEMS_ARM_Q4_G128_MLP_DOWN_STEAL_CHUNK=16
# Keep the OpenMP worker team alive across GateUp/SwiGLU and Down. The last
# GateUp worker packs the shared Down activation before releasing its peers.
# Cold tg128 TPOT: 70.591 ms -> 70.131 ms (+0.66%), exact output tokens.
export FLAGGEMS_ARM_Q4_G128_MLP_PERSISTENT=1
# Reuse the GDN hidden-state quantization and one OpenMP team for qkvz+ba.
# Micro +5.57%; two whole-model A/Bs measured +0.87% and +1.11%. The latter
# used the complete production profile, eight interleaved tg128 samples, and
# retained exact output tokens.
export FLAGGEMS_Q4_FUSED_GDN_INPUT=1
export FLAGGEMS_Q4_FUSED_GDN_G128=1
export FLAGGEMS_Q4_PREFILL_THREADS=18
# The experimental G128 SME2/I8MM hybrid regresses the real vLLM server
# workload on M5 Pro. Keep the packaged implementation available, but do not
# select it in the production profile.
export FLAGGEMS_Q4_G128_SME2_PREFILL=0
export FLAGGEMS_GDN_PREFILL_THREADS=16
# Qwen3.8 has bias-free GDN Conv1D. Its packed C++ path is faster than the
# ordinary Triton launch in end-to-end Decode on this host.
export FLAGGEMS_GDN_TRITON_DECODE=0
export FLAGGEMS_GDN_TRITON_THREADS=14
export FLAGGEMS_GDN_TRITON_BLOCK_KEY=32
# Normalize each completed recurrent value head in its owning worker. This
# removes one temporary/copy and one OpenMP launch per GDN layer. Qwen3.8
# tg128 same-engine A/B: 10.3265s -> 10.2502s, exact tokens, 9/10 paired wins.
export FLAGGEMS_GDN_FUSED_PACKED_NORM=1
# Keep qkvz/ba, recurrent+Norm and output projection inside one native G128
# dispatcher. Cold same-engine tg96 A/B: 7.3411s -> 7.1931s (+2.06%),
# exact tokens, 3/3 paired wins and 4560/4560 Decode-layer route hits.
export FLAGGEMS_GDN_FUSED_FULL_DECODE=1
# Cache the static tensors and eligibility decision behind the proven full
# GDN Decode route. Cold same-engine tg128 A/B: 5/5 wins, paired median +1.97%,
# exact output tokens. This does not change the recurrent math or Q4 kernels.
export FLAGGEMS_GDN_CACHED_FULL_DECODE_ROUTE=1
# Keep Conv1D, recurrence and fused gated Norm in one OpenMP team. Two
# independent whole-model tg96 A/Bs improved median time by 1.00% and 0.76%;
# the latter won 8/11 paired rounds. Outputs and both GDN states were exact.
export FLAGGEMS_GDN_NATIVE_PERSISTENT_DECODE=1
export TRITON_JIT_CPU_DYNAMIC_KERNEL=_q4_prefill_asym_g128_i8mm_kernel
export TRITON_JIT_CPU_DYNAMIC_CHUNK=32
export FL_INT8_LMHEAD=1

export KMP_BLOCKTIME=20
export OMP_NUM_THREADS=14
# Mark six latency-critical team members as interactive so macOS preferentially
# schedules them on the six Super cores; leave the other eight at default QoS.
# Decode tg96 same-engine A/B: +3.29%, 7/7 paired wins. Cold tg128 median:
# 70.13 ms -> 69.23 ms; all output tokens exact.
export FLAGGEMS_ARM_OMP_INTERACTIVE_WORKERS=6
export VLLM_CPU_KVCACHE_SPACE=2
export VLLM_CPU_OMP_THREADS_BIND=nobind
export FL_CPU_UNIPROC=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE=1
export TRITON_LOCAL_LIBOMP_PATH="$FLAGOS_RUNTIME_ROOT"

export TOKENIZERS_PARALLELISM=false
