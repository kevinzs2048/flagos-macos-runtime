# Validated Apple M5 Pro / Mac17,9 multi-model W4A8/W8A8 profile.
# Correctness defaults remain in FlagGems; this file contains deployment and
# measured performance policy only.
export VLLM_PLUGINS=fl
export FL_CPU_INT4=1
export FL_CPU_INT4_BACKEND=libtriton_jit
export FLAGGEMS_VENDOR=arm
export FLAGGEMS_ARM_Q4_STRICT=1

export FLAGGEMS_Q4_DECODE_PARTITIONS=auto
# Cache the prepared packed RHS Parameter and immutable shape on each vLLM
# quant kernel. The W4 and W8 paths preserve Parameter identity through AOT
# deepcopy, without function-valued Module attributes or duplicate storage.
export FLAGGEMS_VLLM_FAST_APPLY=1
: "${FLAGGEMS_Q4_STEAL_CHUNK:=32}"
export FLAGGEMS_Q4_STEAL_CHUNK
export FLAGGEMS_ARM_Q4_G128_STEALING_DECODE=1
# Keep each CPU worker inside a coarse, contiguous N4 stripe for prefill.
# Chunk 2 is the validated M5 Pro policy for supported G128 prefill shapes.
export FLAGGEMS_ARM_Q4_G128_STEALING_PREFILL=1
: "${FLAGGEMS_ARM_Q4_G128_STEAL_CHUNK:=2}"
export FLAGGEMS_ARM_Q4_G128_STEAL_CHUNK
# Eligible G128 prefill is intentionally routed through the KleidiAI-compatible
# M16xN4 shape.  Leaving this unset lets the generic dynamic-shape heuristic
# select M12 for the benchmark's 511 model-input rows and loses the core
# prefill optimization.
export FLAGGEMS_ARM_Q4_G128_PREFILL_BLOCK_M=16
export FLAGGEMS_ARM_Q4_G128_PREFILL_SUBGROUP_UNROLL=1
: "${FLAGGEMS_W8_STEAL_CHUNK:=64}"
export FLAGGEMS_W8_STEAL_CHUNK
export FLAGGEMS_W8_STEALING_PREFILL=1
: "${FLAGGEMS_W8_PREFILL_STEAL_CHUNK:=2}"
export FLAGGEMS_W8_PREFILL_STEAL_CHUNK
# W8 prefill scales through 16 workers on M5 Pro, while single-token SDOT
# decode is steadier with the 14-thread service default. Scope the override so
# optimizing one phase does not regress the other.
: "${FLAGGEMS_W8_PREFILL_THREADS:=16}"
export FLAGGEMS_W8_PREFILL_THREADS
export FLAGGEMS_W8_STEALING_DECODE=1
: "${FLAGGEMS_W8_STEALING_MIN_WORK:=0}"
export FLAGGEMS_W8_STEALING_MIN_WORK
: "${FLAGGEMS_W8_BODY_STEAL_CHUNK:=32}"
export FLAGGEMS_W8_BODY_STEAL_CHUNK
: "${FLAGGEMS_ARM_Q4_G128_SWIGLU_STEALING:=0}"
export FLAGGEMS_ARM_Q4_G128_SWIGLU_STEALING
export FLAGGEMS_Q4_PREFILL_THREADS=18
# These GDN settings are retained for the documented Qwen3.8 compatibility
# path. MiniCPM5 uses Llama attention and does not consume them.
export FLAGGEMS_GDN_PREFILL_THREADS=16
export FLAGGEMS_GDN_TRITON_DECODE=1
export FLAGGEMS_GDN_TRITON_THREADS=14
export FLAGGEMS_GDN_TRITON_BLOCK_KEY=32
export TRITON_JIT_CPU_DYNAMIC_KERNEL=_q4_prefill_asym_g128_i8mm_kernel
export TRITON_JIT_CPU_DYNAMIC_CHUNK=32
export FL_INT8_LMHEAD=1
# Inductor's symbolic token-major kernels are profitable in parallel for
# prefill, but at decode M=1 an OpenMP team has only one outer-loop iteration.
export FLAGOS_INDUCTOR_TOKEN_PARALLEL_GUARD=1

: "${KMP_BLOCKTIME:=20}"
export KMP_BLOCKTIME
: "${OMP_NUM_THREADS:=14}"
export OMP_NUM_THREADS
export VLLM_CPU_KVCACHE_SPACE=2
export VLLM_CPU_OMP_THREADS_BIND=nobind
# Re-testing split-KV did not reproduce the earlier reduction-barrier stall,
# but it slowed MiniCPM 512+128 by roughly 45% and was neutral at 2048+32.
# The unsplit kernel is the validated single-stream policy.
export VLLM_CPU_ATTN_SPLIT_KV=0
export FL_CPU_UNIPROC=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE=1
export TRITON_LOCAL_LIBOMP_PATH="$FLAGOS_RUNTIME_ROOT"

export TOKENIZERS_PARALLELISM=false
