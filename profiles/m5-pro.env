# Validated Apple M5 Pro / Mac17,9 single-stream Qwen W4A8 G128 profile.
# Correctness defaults remain in FlagGems; this file contains deployment and
# measured performance policy only.
export VLLM_PLUGINS=fl
export FL_CPU_INT4=1
export FL_CPU_INT4_BACKEND=libtriton_jit
export FLAGGEMS_VENDOR=arm
export FLAGGEMS_ARM_Q4_STRICT=1

export FLAGGEMS_Q4_DECODE_PARTITIONS=auto
export FLAGGEMS_Q4_STEAL_CHUNK=32
export FLAGGEMS_ARM_Q4_G128_STEALING_DECODE=1
export FLAGGEMS_Q4_PREFILL_THREADS=18
export FLAGGEMS_Q4_G128_SME2_PREFILL=1
export FLAGGEMS_Q4_G128_SME2_SPLITS=34816x5120:10240
export FLAGGEMS_Q4_G128_SME2_I8MM_THREADS=17
export FLAGGEMS_GDN_PREFILL_THREADS=16
export FLAGGEMS_GDN_TRITON_DECODE=1
export FLAGGEMS_GDN_TRITON_THREADS=14
export FLAGGEMS_GDN_TRITON_BLOCK_KEY=32
export TRITON_JIT_CPU_DYNAMIC_KERNEL=_q4_prefill_asym_g128_i8mm_kernel
export TRITON_JIT_CPU_DYNAMIC_CHUNK=32
export FL_INT8_LMHEAD=1

export KMP_BLOCKTIME=20
export OMP_NUM_THREADS=14
export VLLM_CPU_KVCACHE_SPACE=2
export VLLM_CPU_OMP_THREADS_BIND=nobind
export FL_CPU_UNIPROC=1
export VLLM_ENABLE_V1_MULTIPROCESSING=0
export VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE=1
export TRITON_LOCAL_LIBOMP_PATH="$FLAGOS_RUNTIME_ROOT"

export TOKENIZERS_PARALLELISM=false
