# Qwen-Image-2.1: PyTorch CPU, same112 W8A8, native SME2.
# The model adapter selects 18 PyTorch threads and 12 MLP workers.
# Reference Diffusers, KleidiAI and compiler/OpenMP locations are supplied
# by the prepared environment. No vLLM profile is sourced for this route.
export GEMS_VENDOR=arm
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export MAX_JOBS="${MAX_JOBS:-2}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}"
export TORCH_EXTENSIONS_DIR="${TORCH_EXTENSIONS_DIR:-$HOME/Library/Caches/qwen-image-cpu/torch-extensions}"

